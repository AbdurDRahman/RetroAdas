# Copy this to .env and fill in real values. Never commit the real .env.

# Used by the running server (cmd/server/main.go).
# Today this is the same virtual machine as the API. When the database moves to its own machine
# for stress testing, only this value changes — nothing else in the codebase
# should need to change.
DATABASE_URL=postgres://adas_user:changeme@localhost:5432/adas_dev?sslmode=disable

# Used only by tests (database/testdatabase). Keep this pointed at a SEPARATE
# database from DATABASE_URL so manual dev poking and automated tests never
# collide over the same rows.
TEST_DATABASE_URL=postgres://adas_user:changeme@localhost:5432/adas_test?sslmode=disable

SERVER_PORT=8080

# Server-side secret mixed into every API key hash (docs/design.md section 7).
# At least 32 characters. This value is for the laptop only: on the virtual
# machine and in Kubernetes generate a real one with `openssl rand -base64 32`
# and keep it out of git. Changing it invalidates every device key.
API_KEY_PEPPER=development-only-pepper-replace-outside-the-laptop
