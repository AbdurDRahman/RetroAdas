# Copy this to .env and fill in real values. Never commit the real .env.

# Used by the running server (cmd/server/main.go).
# Today this is the same VM as the API. When the DB moves to its own machine
# for stress testing, only this value changes — nothing else in the codebase
# should need to change.
DATABASE_URL=postgres://adas_user:changeme@localhost:5432/adas_dev?sslmode=disable

# Used only by tests (database/testing). Keep this pointed at a SEPARATE
# database from DATABASE_URL so manual dev poking and automated tests never
# collide over the same rows.
TEST_DATABASE_URL=postgres://adas_user:changeme@localhost:5432/adas_test?sslmode=disable

SERVER_PORT=8080
