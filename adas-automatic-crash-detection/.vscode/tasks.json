{
    // Feature 3 tasks. In VS Code: Ctrl+Shift+B runs the default one
    // ("Feature 3: run all checks"); Ctrl+Shift+P -> "Tasks: Run Task" lists them all.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONIOENCODING": "utf-8", "PYTHONUTF8": "1" }
    },
    "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "showReuseMessage": false },
    "problemMatcher": [],
    "tasks": [
        {
            "label": "1. Self-test (synthetic drive, 2 s)",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["eval\\engine.py"]
        },
        {
            "label": "2. Full benchmark -> evaluation.md (~30 s)",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["eval\\run_eval.py", "--print"]
        },
        {
            "label": "3. Old (v1) vs new (v2) -> comparison.md (~1-2 min)",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["eval\\compare_v1.py", "--print"]
        },
        {
            "label": "Feature 3: run all checks",
            "dependsOrder": "sequence",
            "dependsOn": [
                "1. Self-test (synthetic drive, 2 s)",
                "2. Full benchmark -> evaluation.md (~30 s)",
                "3. Old (v1) vs new (v2) -> comparison.md (~1-2 min)"
            ],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Demo: Jetson side",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["jetson\\crash_link.py", "--tcp", "9000", "--gps-fake", "40"],
            "isBackground": true,
            "presentation": { "group": "demo", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Demo: ESP32 replays a REAL crash",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["eval\\replay.py", "vzcrash", "--label", "crash", "--n", "0", "--min-peak", "4", "--tcp", "9000", "--countdown", "5"],
            "presentation": { "group": "demo", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Demo: ESP32 replays a REAL emergency stop (should NOT fire)",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["eval\\replay.py", "vzcrash", "--label", "near_miss", "--n", "0", "--tcp", "9000", "--countdown", "5"],
            "presentation": { "group": "demo", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Demo: crash end-to-end (Jetson + ESP32 side by side)",
            "dependsOrder": "parallel",
            "dependsOn": ["Demo: Jetson side", "Demo: ESP32 replays a REAL crash"]
        },
        {
            "label": "Demo: emergency stop end-to-end (Jetson + ESP32 side by side)",
            "dependsOrder": "parallel",
            "dependsOn": ["Demo: Jetson side", "Demo: ESP32 replays a REAL emergency stop (should NOT fire)"]
        }
    ]
}
